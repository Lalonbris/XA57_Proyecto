@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4 class="xa57-title" style="font-size:1.3rem;">@ViewData["Title"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    
    <div class="xa57-form-group">
        <label asp-for="Username" class="form-label">Email (Nombre de usuario)</label>
        <input asp-for="Username" class="form-control" placeholder="nombre@ejemplo.com" disabled />
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="xa57-form-group">
                <label asp-for="Input.Nombre" class="form-label"></label>
                <input asp-for="Input.Nombre" class="form-control" />
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="xa57-form-group">
                <label asp-for="Input.Apellido" class="form-label"></label>
                <input asp-for="Input.Apellido" class="form-control" />
                <span asp-validation-for="Input.Apellido" class="text-danger"></span>
            </div>
        </div>
    </div>
    
    <div class="xa57-form-group">
        <label asp-for="Input.PhoneNumber" class="form-label"></label>
        <input asp-for="Input.PhoneNumber" class="form-control" />
        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
    </div>
    
    <button id="update-profile-button" type="submit" class="btn-xa57 btn-xa57-primary mt-3">
        Guardar cambios
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
