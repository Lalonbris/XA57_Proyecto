@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="xa57-auth-container">
    <div>
        <span class="xa57-label">Acceso</span>
        <h1 class="xa57-title">Inicia Sesión</h1>
    </div>
    
    <section>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="xa57-form-group">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <div class="xa57-form-group">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label" style="font-size:0.8rem;color:var(--tx-2);">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="btn-xa57 btn-xa57-ghost" style="font-size:0.75rem;">¿Olvidaste tu contraseña?</a>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn-xa57 btn-xa57-primary mt-3">
                Iniciar sesión
            </button>

            <div class="text-center mt-4">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn-xa57 btn-xa57-ghost">
                    ¿No tienes cuenta? Regístrate
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
