@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-xa57 d-flex align-items-center text-white full-width-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 px-4">
                <div class="mb-3">
                    <span class="badge-official">OFFICIAL MERCHANDISE</span>
                </div>
                <h1 class="display-2 fw-bold mb-3 hero-title">
                    RIDE THE <span class="text-gold">VIBE</span>
                </h1>
                <p class="lead mb-4 text-silver-bright">
                    Premium bus-themed plushies, apparel, and accessories for the transit enthusiast in you. Get on board with XA57.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Catalogo" class="btn btn-gold btn-lg px-4">Comprar Ahora</a>
                    <a href="#" class="btn btn-outline-white btn-lg px-4">View Collections</a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block text-center">
                <div class="hero-placeholder-box mx-auto">
                    <span class="text-accent fs-5">Vista del Producto</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5 mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-6 text-black">TRANSIT ESSENTIALS</h2>
        <p class="text-accent">Everything you need to show your love for the road.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="cat-card-box">
                <div class="cat-gradient">
                    <h4 class="fw-bold text-white mb-1">Plushies</h4>
                    <a href="#" class="text-decoration-none fw-bold text-gold link-shop">Shop Plushies &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cat-card-box">
                <div class="cat-gradient">
                    <h4 class="fw-bold text-white mb-1">Comfort Gear</h4>
                    <a href="#" class="text-decoration-none fw-bold text-gold link-shop">Shop Comfort &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cat-card-box">
                <div class="cat-gradient">
                    <h4 class="fw-bold text-white mb-1">Accessories</h4>
                    <a href="#" class="text-decoration-none fw-bold text-gold link-shop">Shop Accessories &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="fw-bold text-black">Fresh Off The Lot</h3>
            <p class="small text-accent mb-0">Newest additions to our fleet.</p>
        </div>
        <a href="#" class="text-decoration-none fw-bold mb-1 text-gold link-shop">View All Products &rarr;</a>
    </div>

    <div class="row g-4">
        <div class="col-6 col-lg-3">
            <div class="product-img-holder d-flex justify-content-center align-items-center">
                <span class="text-accent small">Sin Imagen</span>
            </div>
            <h6 class="fw-bold mb-0 text-silver-bright">XA57 Metal Keychain</h6>
            <p class="text-accent small mb-1">Die-cast miniature replica</p>
            <p class="fw-bold mb-0 text-gold">$12.99</p>
        </div>
        <div class="col-6 col-lg-3">
            <div class="product-img-holder d-flex justify-content-center align-items-center">
                <span class="text-accent small">Sin Imagen</span>
            </div>
            <h6 class="fw-bold mb-0 text-silver-bright">Jumbo Bus Pillow</h6>
            <p class="text-accent small mb-1">Ultra-soft velvet finish</p>
            <p class="fw-bold mb-0 text-gold">$34.99</p>
        </div>
    </div>
</section>

<section class="full-width-section py-5 personalization-banner">
    <div class="container py-4 text-white">
        <div class="row align-items-center">
            <div class="col-md-8">
                <p class="small fw-bold text-uppercase mb-2 text-accent studio-label">Personalization Studio</p>
                <h2 class="display-4 fw-bold mb-4 text-silver-bright">DESIGN YOUR OWN FLEET</h2>
                <p class="mb-4 w-75 text-silver">
                    Want a specific route number? Custom colors? Use our customization tool to create a one-of-a-kind plushie or keychain.
                </p>
                <button class="btn btn-gold px-4 py-2">&checkmark; Start Customizing</button>
            </div>
            <div class="col-md-4 text-center d-none d-md-block">
                <div class="dashed-circle">
                    <div class="icon-box">🎨</div>
                </div>
            </div>
        </div>
    </div>
</section>