@{
    ViewData["Title"] = "Inicio";
}

<!-- ══ HERO ══ -->
<section class="xa57-hero full-width">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-7">
                <span class="xa57-hero__eyebrow">Official Merchandise</span>

                <h1 class="xa57-hero__title">
                    RIDE<br>
                    THE <span class="outline">VIBE</span>
                </h1>

                <p class="xa57-hero__subtitle">
                    Premium bus-themed plushies, apparel, and accessories for the transit enthusiast.
                    Authentic liveries. One-of-a-kind pieces.
                </p>

                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Home" asp-action="Catalogo" class="btn-xa57 btn-xa57-primary">
                        Comprar Ahora
                    </a>
                    <a href="#colecciones" class="btn-xa57 btn-xa57-secondary">
                        Ver Colecciones
                    </a>
                </div>
            </div>

            <div class="col-lg-5 d-none d-lg-flex justify-content-center">
                <div class="xa57-hero__visual">
                    <div class="xa57-hero__ring">
                        <span class="xa57-hero__ring-label">XA57</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ══ CATEGORIES ══ -->
<section class="container xa57-section" id="colecciones">
    <div class="mb-5">
        <span class="xa57-label">Colecciones</span>
        <h2 class="xa57-title" style="font-size: 2.2rem;">Transit Essentials</h2>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="xa57-cat-card">
                <div class="xa57-cat-card__deco"></div>
                <span class="xa57-cat-card__num">01</span>
                <div class="xa57-cat-card__body">
                    <h3 class="xa57-cat-card__title">Plushies</h3>
                    <a href="#" class="xa57-cat-card__link">
                        Shop Plushies
                        <i class="material-icons">arrow_forward</i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="xa57-cat-card">
                <div class="xa57-cat-card__deco"></div>
                <span class="xa57-cat-card__num">02</span>
                <div class="xa57-cat-card__body">
                    <h3 class="xa57-cat-card__title">Comfort Gear</h3>
                    <a href="#" class="xa57-cat-card__link">
                        Shop Comfort
                        <i class="material-icons">arrow_forward</i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="xa57-cat-card">
                <div class="xa57-cat-card__deco"></div>
                <span class="xa57-cat-card__num">03</span>
                <div class="xa57-cat-card__body">
                    <h3 class="xa57-cat-card__title">Accessories</h3>
                    <a href="#" class="xa57-cat-card__link">
                        Shop Accessories
                        <i class="material-icons">arrow_forward</i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══ FRESH OFF THE LOT ══ -->
<section class="container" style="padding-bottom: 80px;">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="xa57-label">Novedades</span>
            <h3 class="xa57-title mb-0" style="font-size: 1.6rem;">Fresh Off The Lot</h3>
        </div>
        <a href="#" class="btn-xa57 btn-xa57-ghost" style="font-size:0.78rem;">
            Ver todo &rarr;
        </a>
    </div>

    <div class="row g-4">
        <div class="col-6 col-lg-3">
            <div class="xa57-product-thumb__img">Sin imagen</div>
            <p class="xa57-product-thumb__name">XA57 Metal Keychain</p>
            <p class="xa57-product-thumb__desc">Die-cast miniature replica</p>
            <p class="xa57-product-thumb__price">$12.99</p>
        </div>
        <div class="col-6 col-lg-3">
            <div class="xa57-product-thumb__img">Sin imagen</div>
            <p class="xa57-product-thumb__name">Jumbo Bus Pillow</p>
            <p class="xa57-product-thumb__desc">Ultra-soft velvet finish</p>
            <p class="xa57-product-thumb__price">$34.99</p>
        </div>
    </div>
</section>

<!-- ══ PERSONALIZATION STUDIO ══ -->
<section class="xa57-studio full-width">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-8">
                <span class="xa57-label">Personalization Studio</span>
                <h2 class="xa57-title mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -1px;">
                    Design Your<br>Own Fleet
                </h2>
                <p class="text-xa57-muted mb-5" style="max-width: 460px; line-height: 1.8; font-size: 0.95rem;">
                    Custom color schemes, route numbers, and special requests.
                    Create a one-of-a-kind piece with our in-browser configurator.
                </p>
                <a asp-controller="Home" asp-action="Catalogo" class="btn-xa57 btn-xa57-primary">
                    Start Customizing
                </a>
            </div>

            <div class="col-md-4 d-none d-md-flex justify-content-center">
                <div class="xa57-studio__icon">
                    <i class="material-icons">brush</i>
                </div>
            </div>

        </div>
    </div>
</section>
