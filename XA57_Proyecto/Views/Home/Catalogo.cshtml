@model List<XA57_Proyecto.Domain.Entities.Producto>

@{
    ViewData["Title"] = "Catálogo";
}

<div style="padding: 52px 0 80px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <span class="xa57-label">@Model.Count productos disponibles</span>
            <h1 class="xa57-title mb-0" style="font-size: 2.4rem;">Catálogo</h1>
        </div>
    </div>

    <!-- Grid -->
    @if (Model.Any())
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px;">
            @foreach (var producto in Model)
            {
                <div class="xa57-product-card">
                    <div class="xa57-product-card__img">
                        <img src="@producto.ImagenUrl"
                             alt="@producto.Nombre"
                             loading="lazy"
                             onerror="this.src='/images/placeholder.png'" />
                    </div>
                    <div class="xa57-product-card__body">
                        <span class="xa57-product-card__cat">@producto.TipoProducto?.Nombre</span>
                        <p class="xa57-product-card__name">@producto.Nombre</p>
                        <p class="xa57-product-card__desc">@producto.Descripcion</p>
                        <div class="xa57-product-card__footer">
                            <span class="xa57-product-card__price">$@producto.Precio</span>
                            <button class="xa57-product-card__cta"
                                    onclick="abrirModal(@producto.Id, '@producto.Nombre')">
                                Ver
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="xa57-empty">
            <i class="material-icons xa57-empty__icon">inventory_2</i>
            <p class="xa57-empty__text">No hay productos disponibles.</p>
        </div>
    }

</div>

<!-- Modal -->
<div id="modal-producto" class="xa57-modal-overlay">
    <div class="xa57-modal">
        <h3 id="modal-nombre" class="xa57-modal__name"></h3>
        <p class="xa57-modal__text">
            Personaliza este producto con colores y numero de unidad, o agrégalo directamente.
        </p>
        <div class="d-flex flex-column gap-3">
            <a id="modal-btn-personalizar" href="#" class="btn-xa57 btn-xa57-primary">
                <i class="material-icons" style="font-size:16px;">tune</i>
                Personalizar y agregar
            </a>
            <button id="modal-btn-carrito" class="btn-xa57 btn-xa57-secondary">
                <i class="material-icons" style="font-size:16px;">shopping_bag</i>
                Agregar sin personalizar
            </button>
            <button onclick="cerrarModal()" class="btn-xa57 btn-xa57-ghost">
                Cancelar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productoIdActual = null;

        function abrirModal(id, nombre) {
            productoIdActual = id;
            document.getElementById("modal-nombre").textContent = nombre;
            document.getElementById("modal-btn-personalizar").href = "/Productos/Detalle/" + id;
            document.getElementById("modal-producto").style.display = "flex";
        }

        function cerrarModal() {
            document.getElementById("modal-producto").style.display = "none";
            productoIdActual = null;
        }

        document.getElementById("modal-btn-carrito").addEventListener("click", async () => {
            const response = await fetch("/Carrito/Agregar", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    productoId: productoIdActual,
                    cantidad: 1
                })
            });
            cerrarModal();
            if (response.ok) {
                fetch('/Carrito/Cantidad')
                    .then(r => r.json())
                    .then(n => {
                        if (n > 0) {
                             var badge = document.getElementById('cart-badge');
                            badge.textContent = n;
                            badge.style.display = 'flex';
                        }
                    });
                mostrarToast("Producto agregado al carrito.");
            }
        });

        document.getElementById("modal-producto").addEventListener("click", e => {
            if (e.target === document.getElementById("modal-producto")) cerrarModal();
        });

        function mostrarToast(texto) {
            const t = document.createElement("div");
            t.textContent = texto;
            Object.assign(t.style, {
                position: "fixed", bottom: "28px", right: "28px",
                background: "#fff", color: "#080808",
                padding: "13px 20px",
                borderRadius: "10px",
                fontFamily: "Inter, sans-serif",
                fontSize: "13px",
                fontWeight: "600",
                boxShadow: "0 8px 32px rgba(0,0,0,0.45)",
                zIndex: "9999",
                opacity: "0",
                transition: "opacity 0.2s ease, transform 0.2s ease",
                transform: "translateY(8px)"
            });
            document.body.appendChild(t);
            requestAnimationFrame(() => {
                t.style.opacity = "1";
                t.style.transform = "translateY(0)";
            });
            setTimeout(() => {
                t.style.opacity = "0";
                t.style.transform = "translateY(8px)";
                setTimeout(() => t.remove(), 220);
            }, 2600);
        }
    </script>
}
