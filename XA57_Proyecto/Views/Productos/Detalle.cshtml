@model XA57_Proyecto.Domain.Entities.Producto
@{
    ViewData["Title"] = Model.Nombre;
}

<div style="display: flex; gap: 40px; padding: 40px; max-width: 1100px; margin: 0 auto;">

    <div id="configurador-root"
         data-producto-id="@Model.Id"
         data-producto-nombre="@Model.Nombre"
         data-producto-imagen="@Model.ImagenUrl"
         data-permite-nombre="@(Model.TipoProducto?.PermiteNombre.ToString().ToLower() ?? "true")"
         data-permite-numero-economico="@(Model.TipoProducto?.PermiteNumeroEconomico.ToString().ToLower() ?? "true")"
         data-permite-ruta="@(Model.TipoProducto?.PermiteRuta.ToString().ToLower() ?? "true")"
         data-max-caracteres="@(Model.TipoProducto?.MaxCaracteres ?? 20)">
    </div>

</div>

@section Scripts {
    <script src="~/configurador/static/js/main.js"></script>
}
