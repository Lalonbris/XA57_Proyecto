@model XA57_Proyecto.Domain.Entities.Producto
@{
    ViewData["Title"] = Model.Nombre;
    var tipo = Model.TipoProducto;
}

<div style="display: flex; gap: 40px; padding: 40px; max-width: 1100px; margin: 0 auto;">

    <div id="configurador-root"
         data-producto-id="@Model.Id"
         data-producto-nombre="@Model.Nombre"
         data-producto-imagen="@Model.ImagenUrl"
         data-permite-nombre="@(tipo?.PermiteNombre.ToString().ToLower() ?? "true")"
         data-permite-numero-economico="@(tipo?.PermiteNumeroEconomico.ToString().ToLower() ?? "true")"
         data-permite-ruta="@(tipo?.PermiteRuta.ToString().ToLower() ?? "true")"
         data-max-caracteres="@(tipo?.MaxCaracteres ?? 20)"
         style="display: flex; gap: 40px; width: 100%;">
    </div>

</div>

@section Scripts {
    <script src="~/react/static/js/main.e292cae9.js"></script>
}
