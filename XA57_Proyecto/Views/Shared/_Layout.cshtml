<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - XA57</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual      = ViewContext.RouteData.Values["action"]?.ToString();
}

<body data-user-authenticated="@(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false")">
    <header>
        <nav class="navbar navbar-expand-sm xa57-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">XA57</a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter:invert(0.7);"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex align-items-center justify-content-between">

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(controladorActual == "Home" && accionActual == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(accionActual == "Catalogo" ? "active" : "")"
                               asp-controller="Home" asp-action="Catalogo">Catálogo</a>
                        </li>
                    </ul>

                    @if (accionActual == "Catalogo")
                    {
                        <input class="xa57-search" type="search" placeholder="Buscar productos..." />
                    }
                    else if (controladorActual == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="material-icons">dashboard</i> Dashboard
                        </a>
                    }
                    else if (accionActual == "Detalle" && controladorActual == "Productos")
                    {
                        <span class="personalization-indicator">
                            <i class="material-icons">brush</i>
                            Modo Personalización
                        </span>
                    }

                    <ul class="navbar-nav">
                        <li class="nav-item d-flex align-items-center">
                            <partial name="_LoginPartial" />
                        </li>
                        <li class="nav-item d-flex align-items-center">
                            <a class="xa57-cart-btn" asp-controller="Carrito" asp-action="Index">
                                <i class="material-icons" style="font-size:19px;">shopping_bag</i>
                                <span class="xa57-badge" id="cart-badge" style="display:none;">0</span>
                            </a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Modal para solicitar inicio de sesión -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content xa57-modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Inicio de Sesión Requerido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Necesitas iniciar sesión para agregar productos a tu carrito.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <a href="/Identity/Account/Login" class="btn btn-primary">Iniciar Sesión</a>
                </div>
            </div>
        </div>
    </div>
 
    <footer class="xa57-footer">
        <div class="container text-center">
            &copy; 2026 XA57 Coleccionables &nbsp;&middot;&nbsp;
            <a asp-controller="Home" asp-action="Privacy">Política de Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        window.actualizarIconoCarrito = function () {
            console.log("actualizarIconoCarrito FUE LLAMADA");
            fetch('/Carrito/Cantidad')
                .then(response => response.json())
                .then(cantidad => {
                    console.log("Cantidad recibida:", cantidad);
                    const cartBadge = document.getElementById('cart-badge');
                    if (cartBadge) {
                        cartBadge.textContent = cantidad;
                        cartBadge.style.display = cantidad > 0 ? 'flex' : 'none';
                    }
                });
        }
        console.log("actualizarIconoCarrito DEFINIDA EN WINDOW");
        document.addEventListener('DOMContentLoaded', window.actualizarIconoCarrito);
    </script>
</body>
</html>
