<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - XA57</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>

@{
        // Magia de ASP.NET: Obtenemos el controlador y la acción actual
        var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
        var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
}

<body style="background-color: var(--color-negro-fondo); color: var(--color-plata-principal);">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: var(--color-negro-superficie); border-bottom-color: var(--color-acento) !important;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" style="color: var(--color-plata-brillante);" asp-area="" asp-controller="Home" asp-action="Index">
                    XA57
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link @(controladorActual == "Home" && accionActual == "Index" ? "text-white fw-bold" : "")"
                               style="color: var(--color-plata-principal);"
                               asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(accionActual == "Catalogo" ? "text-white fw-bold" : "")"
                               style="color: var(--color-plata-principal);"
                               asp-controller="Home" asp-action="Catalogo">Catálogo</a>
                        </li>

                    </ul>

                    @if (accionActual == "Catalogo")
                    {
                        <form class="d-flex mx-auto w-50">
                            <input class="form-control me-2 text-white" type="search" placeholder="Buscar líneas (ej. Primera Plus, ETN)..." aria-label="Search" style="background-color: #2a2a2a; border: 1px solid var(--color-acento);">
                            <button class="btn btn-outline-light" type="submit">Buscar</button>
                        </form>
                    }
                    else if (accionActual == "Detalle" && controladorActual == "Productos")
                    {
                        <span class="navbar-text fw-bold text-warning me-3">
                            <i class="material-icons align-middle" style="font-size: 18px;">brush</i> Modo Personalización Activo
                        </span>
                    }

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">
                                <i class="material-icons align-middle">shopping_cart</i>
                                <span class="badge rounded-pill bg-danger">0</span>
                            </a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5" style="border-top-color: var(--color-acento) !important;">
        <div class="container text-center" style="color: var(--color-plata-principal);">
            &copy; 2026 - XA57 Coleccionables - <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: var(--color-plata-brillante);">Política de Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>