@model XA57_Proyecto.ViewModels.CarritoViewModel

@{
    ViewData["Title"] = "Mi Carrito";
}

<div style="max-width: 820px; margin: 0 auto; padding: 52px 0 80px;">

    <!-- Header -->
    <div class="mb-5">
        <span class="xa57-label">Tu carrito</span>
        <h1 class="xa57-title mb-0" style="font-size: 2.2rem;">
            @Model.Items.Count @(Model.Items.Count == 1 ? "Producto" : "Productos")
        </h1>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="xa57-empty">
            <i class="material-icons xa57-empty__icon">shopping_bag</i>
            <p class="xa57-empty__text">Tu carrito está vacío.</p>
            <a asp-controller="Home" asp-action="Catalogo" class="btn-xa57 btn-xa57-primary">
                Explorar Catálogo
            </a>
        </div>
    }
    else
    {
        <!-- Items -->
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var item in Model.Items)
            {
                <div class="xa57-cart-item">

                    <div class="xa57-cart-item__img">
                        <img src="@item.Producto?.ImagenUrl"
                             alt="@item.Producto?.Nombre"
                             onerror="this.src='/images/placeholder.png'" />
                    </div>

                    <div class="xa57-cart-item__info">
                        <p class="xa57-cart-item__name">@item.Producto?.Nombre</p>
                        <div class="xa57-cart-item__meta">
                            @if (item.ModeloAutobus != null)
                            {
                                <span>
                                    <span class="xa57-cart-item__meta-key">Modelo</span>@item.ModeloAutobus.Nombre
                                </span>
                            }
                            @if (item.Linea != null)
                            {
                                <span>
                                    <span class="xa57-cart-item__meta-key">Línea</span>@item.Linea.Nombre
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.NombreOperador))
                            {
                                <span>
                                    <span class="xa57-cart-item__meta-key">Operador</span>@item.NombreOperador
                                </span>
                            }
                             @if (!string.IsNullOrWhiteSpace(item.NumeroEconomico))
                             {
                                 <span>
                                     <span class="xa57-cart-item__meta-key">No. Económico</span>#@item.NumeroEconomico
                                 </span>
                             }
                            @if (!string.IsNullOrWhiteSpace(item.Color))
                            {
                                <span>
                                    <span class="xa57-cart-item__meta-key">Color</span>
                                    <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: @item.ColorHex; margin-right: 5px; vertical-align: middle;"></span>
                                    @item.Color
                                </span>
                            }
                             @if (!string.IsNullOrWhiteSpace(item.Ruta))
                             {
                                 <span>
                                    <span class="xa57-cart-item__meta-key">Ruta</span>@item.Ruta
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.NotasEspeciales))
                            {
                                <span>
                                    <span class="xa57-cart-item__meta-key">Notas</span>@item.NotasEspeciales
                                </span>
                            }
                            <span>
                                <span class="xa57-cart-item__meta-key">Cant.</span>@item.Cantidad
                            </span>
                        </div>
                    </div>

                    <div class="xa57-cart-item__price">
                        <p class="xa57-cart-item__subtotal">$@((item.Producto?.Precio ?? 0) * item.Cantidad)</p>
                        @if (item.Cantidad > 1)
                        {
                            <p class="xa57-cart-item__unit">$@item.Producto?.Precio c/u</p>
                        }
                    </div>

                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post">
                        <button type="submit" class="xa57-cart-item__del" title="Eliminar">
                            <i class="material-icons">delete_outline</i>
                        </button>
                    </form>

                </div>
            }
        </div>

        <!-- Summary -->
        <div class="xa57-cart-summary">
            <div class="xa57-cart-summary__row">
                <span class="xa57-cart-summary__label">
                    Total &middot; @Model.Items.Sum(i => i.Cantidad) unidades
                </span>
                <span class="xa57-cart-summary__total">$@Model.Total</span>
            </div>
            <div class="xa57-cart-summary__actions">
                <a asp-controller="Home" asp-action="Catalogo" class="btn-xa57 btn-xa57-secondary">
                    Seguir comprando
                </a>
                <button type="button" class="btn-xa57 btn-xa57-primary" data-bs-toggle="modal" data-bs-target="#modalPago">
                    Confirmar pedido
                </button>
            </div>
        </div>
    }

</div>

<!-- Modal de Pago -->
<div class="modal fade" id="modalPago" tabindex="-1" aria-labelledby="modalPagoLabel" aria-hidden="true" data-bs-theme="dark">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background-color: var(--bg-2); border: 1px solid var(--bd-2);">
      <div class="modal-header" style="border-bottom: 1px solid var(--bd-1);">
        <h5 class="modal-title" id="modalPagoLabel" style="color: var(--tx-0); font-family: var(--ff-h);">Hoja de Ayuda de Pago</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="color: var(--tx-1);">
        <p>Para procesar tu pedido, debes realizar una transferencia interbancaria con los siguientes datos:</p>
        <div style="background-color: var(--bg-3); padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            <p style="margin-bottom: 5px;"><strong>Banco:</strong> Banco de Prueba S.A.</p>
            <p style="margin-bottom: 5px;"><strong>Beneficiario:</strong> XA57 Proyecto</p>
            <p style="margin-bottom: 5px;"><strong>CLABE:</strong> <span style="color: #60a5fa; font-size: 1.1em;">1234567890</span></p>
            <p style="margin-bottom: 0;"><strong>Monto a pagar:</strong> <span style="color: var(--tx-0); font-weight: bold;">$@Model.Total.ToString("N2")</span></p>
        </div>
        <p>Descarga tu hoja de ayuda en PDF para ver todos los detalles. Una vez que realices el pago, confirma para enviar tu pedido a validación.</p>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--bd-1);">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <a href="/Carrito/DescargarHojaAyuda" target="_blank" class="btn btn-primary" style="background-color: #3b82f6; border-color: #3b82f6; color: white;">
            <i class="material-icons" style="font-size: 18px; vertical-align: middle; margin-right: 5px;">download</i> Descargar PDF
        </a>
        <button type="button" class="btn btn-success" onclick="confirmarPago()">
            Confirmar y Enviar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
async function confirmarPago() {
    try {
        const response = await fetch('/Carrito/ConfirmarPago', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        if (response.ok) {
            alert('¡Tu pedido ha sido enviado a pago exitosamente!');
            
            // Actualizar el icono del carrito
            if (window.actualizarIconoCarrito) {
                window.actualizarIconoCarrito();
            }
            
            window.location.href = '/Home/Catalogo'; // Redirigir al catálogo después de confirmar
        } else {
            alert('Ocurrió un error al procesar el pago.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión.');
    }
}
</script>
