@model IEnumerable<XA57_Proyecto.Domain.Entities.Pedido>
@{
    ViewData["Title"] = "Administrar Pedidos";
    Layout = "_AdminLayout";
    
    string GetEstadoColor(string estado) {
        return estado switch {
            "Recibido" => "xa57-badge--received",
            "En producción" => "xa57-badge--processing",
            "Enviado" => "xa57-badge--completed",
            "Entregado" => "xa57-badge--success",
            _ => "xa57-badge--default"
        };
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="xa57-title">Pedidos</h1>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" id="filtroEstado" onchange="filtrarPedidos()" style="width: 200px;">
                <option value="">Todos los estados</option>
                <option value="Recibido">Recibido</option>
                <option value="En producción">En producción</option>
                <option value="Enviado">Enviado</option>
                <option value="Entregado">Entregado</option>
            </select>
        </div>
    </div>
    
    <div class="xa57-table-container">
        <table class="xa57-table" id="pedidosTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Cant.</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model)
                {
                    <tr data-id="@pedido.Id">
                        <td>#@pedido.Id</td>
                        <td>@pedido.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pedido.Producto?.Nombre</td>
                        <td>@pedido.Cantidad</td>
                        <td>@pedido.NombreOperador</td>
                        <td class="col-estado">@pedido.Estado</td>
                        <td>
                            <button class="xa57-btn-icon" title="Ver Detalle" onclick="verPedido(@pedido.Id)">
                                <i class="material-icons">visibility</i>
                            </button>
                            <button class="xa57-btn-icon" title="Lista de Picking" onclick="window.open('/Admin/ListaPicking/@pedido.Id', '_blank')">
                                <i class="material-icons">print</i>
                            </button>
                            @if (pedido.Estado == "Recibido")
                            {
                                <button class="xa57-btn-icon xa57-btn-icon--success btn-next-state" title="Enviar a Manufactura" onclick="cambiarEstado(@pedido.Id, 'En producción')">
                                    <i class="material-icons">factory</i>
                                </button>
                            }
                            else if (pedido.Estado == "En producción")
                            {
                                <button class="xa57-btn-icon xa57-btn-icon--success btn-next-state" title="Marcar como Enviado" onclick="cambiarEstado(@pedido.Id, 'Enviado')">
                                    <i class="material-icons">local_shipping</i>
                                </button>
                            }
                            else if (pedido.Estado == "Enviado")
                            {
                                <button class="xa57-btn-icon xa57-btn-icon--success btn-next-state" title="Marcar como Entregado" onclick="cambiarEstado(@pedido.Id, 'Entregado')">
                                    <i class="material-icons">check_circle</i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="pedidoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="xa57-modal-content">
            <div class="xa57-modal-header">
                <h5 class="xa57-modal-title">Detalle del Pedido #<span id="pedidoDetalleId"></span></h5>
                <button type="button" class="xa57-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="xa57-modal-body" id="pedidoDetalle">
            </div>
            <div class="xa57-modal-footer">
                <button type="button" class="btn btn-xa57-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<style>
.xa57-table-container {
    background: var(--bg-2);
    border: 1px solid var(--bd-1);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ff-b);
    font-size: 0.85rem;
}

.xa57-table thead {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
}

.xa57-table th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--tx-2);
    letter-spacing: 0.02em;
}

.xa57-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--bd-0);
    color: var(--tx-0);
}

.xa57-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--r-s);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

.xa57-badge--received { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
.xa57-badge--processing { background: rgba(234, 179, 8, 0.15); color: #facc15; }
.xa57-badge--completed { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
.xa57-badge--success { background: rgba(16, 185, 129, 0.15); color: #10b981; }
.xa57-badge--cancelled { background: rgba(239, 68, 68, 0.15); color: #f87171; }
.xa57-badge--default { background: rgba(107, 114, 128, 0.15); color: #9ca3af; }

.xa57-btn-icon {
    background: var(--bg-3);
    border: 1px solid var(--bd-1);
    color: var(--tx-1);
    border-radius: var(--r-s);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--t);
    margin-right: 4px;
}

.xa57-btn-icon:hover {
    background: var(--bg-4);
    border-color: var(--bd-2);
    color: #fff;
}

.xa57-btn-icon--success:hover {
    background: rgba(34, 197, 94, 0.15);
    border-color: #22c55e;
    color: #22c55e;
}

.xa57-modal-body {
    padding: 20px;
    color: var(--tx-0);
    font-family: var(--ff-b);
    font-size: 0.9rem;
}

.xa57-modal-body p { margin-bottom: 8px; color: var(--tx-1); }
.xa57-modal-body strong { color: var(--tx-0); font-weight: 600; }
</style>

<script>
function filtrarPedidos() {
    const estado = document.getElementById('filtroEstado').value;
    window.location.href = `/Admin/Pedidos?estado=${estado}`;
}

// Set initial value for filter
const urlParams = new URLSearchParams(window.location.search);
if (urlParams.has('estado')) {
    document.getElementById('filtroEstado').value = urlParams.get('estado');
}

async function verPedido(id) {
    const response = await fetch(`/Admin/PedidoDetalle?id=${id}`);
    const pedido = await response.json();
    
    document.getElementById('pedidoDetalleId').textContent = pedido.id;
    document.getElementById('pedidoDetalle').innerHTML = `
        <div class="row">
            <div class="col-md-6">
                <p><strong>Producto:</strong> ${pedido.producto?.nombre || 'N/A'}</p>
                <p><strong>Cantidad:</strong> ${pedido.cantidad}</p>
                <p><strong>Estado:</strong> ${pedido.estado}</p>
                <p><strong>Fecha:</strong> ${new Date(pedido.fechaCreacion).toLocaleString()}</p>
            </div>
            <div class="col-md-6">
                <p><strong>Cliente:</strong> ${pedido.nombreOperador || 'N/A'}</p>
                <p><strong>Número Económico:</strong> ${pedido.numeroEconomico || 'N/A'}</p>
                <p><strong>Color:</strong> ${pedido.color || 'N/A'} (${pedido.colorHex || ''})</p>
                <p><strong>Ruta:</strong> ${pedido.ruta || 'N/A'}</p>
            </div>
        </div>
        ${pedido.notasEspeciales ? `<p><strong>Notas:</strong> ${pedido.notasEspeciales}</p>` : ''}
    `;
    
    const modal = new bootstrap.Modal(document.getElementById('pedidoModal'));
    modal.show();
}

async function cambiarEstado(id, nuevoEstado) {
    const response = await fetch(`/Admin/ActualizarEstadoPedido?id=${id}`, { 
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(nuevoEstado)
    });
    
    if (response.ok) {
        // En este caso, para Pedidos, es mejor recargar o actualizar la fila.
        // Vamos a actualizar la fila para seguir con la política de no recargar.
        actualizarFilaPedido(id, nuevoEstado);
    } else {
        const data = await response.json();
        alert(data.message || 'Error al actualizar el estado');
    }
}

function actualizarFilaPedido(id, nuevoEstado) {
    const fila = document.querySelector(`#pedidosTable tbody tr[data-id="${id}"]`);
    if (!fila) return;
    
    const badge = fila.querySelector('.col-estado .xa57-badge');
    badge.textContent = nuevoEstado;
    
    // Update badge color
    badge.className = 'xa57-badge ' + getEstadoColorClass(nuevoEstado);
    
    // Update action buttons (next state)
    const actionsCell = fila.querySelector('td:last-child');
    const btnNext = actionsCell.querySelector('.btn-next-state');
    
    if (nuevoEstado == 'Entregado') {
        if (btnNext) btnNext.remove();
    } else {
        const nextState = nuevoEstado == 'Recibido' ? 'En producción' : 
                          nuevoEstado == 'En producción' ? 'Enviado' : 
                          nuevoEstado == 'Enviado' ? 'Entregado' : null;
        
        if (nextState && btnNext) {
            btnNext.onclick = () => cambiarEstado(id, nextState);
            const icon = btnNext.querySelector('.material-icons');
            if (nuevoEstado == 'En producción') {
                icon.textContent = 'local_shipping';
                btnNext.title = 'Marcar como Enviado';
            } else if (nuevoEstado == 'Enviado') {
                icon.textContent = 'check_circle';
                btnNext.title = 'Marcar como Entregado';
            }
        }
    }
}

function getEstadoColorClass(estado) {
    switch(estado) {
        case "Recibido": return "xa57-badge--received";
        case "En producción": return "xa57-badge--processing";
        case "Enviado": return "xa57-badge--completed";
        case "Entregado": return "xa57-badge--success";
        default: return "xa57-badge--default";
    }
}
</script>