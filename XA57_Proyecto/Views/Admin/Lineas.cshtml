@model IEnumerable<XA57_Proyecto.Domain.Entities.Linea>
@{
    ViewData["Title"] = "Administrar Lííneas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="xa57-title">Líneas</h1>
        <button class="btn btn-xa57-primary" data-bs-toggle="modal" data-bs-target="#lineaModal" onclick="limpiarFormulario()">
            <i class="material-icons">add</i> Nueva Línea
        </button>
    </div>
    
    <div class="xa57-table-container">
        <table class="xa57-table" id="lineasTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Operador</th>
                    <th>Color Primario</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linea in Model)
                {
                    <tr>
                        <td>@linea.Id</td>
                        <td>@linea.Nombre</td>
                        <td>@linea.NombreOperador</td>
                        <td>
                            <span style="display:inline-block;width:20px;height:20px;background:@linea.ColorPrimario;border-radius:3px;vertical-align:middle;margin-right:8px;border:1px solid var(--bd-1);"></span>
                            @linea.ColorPrimario
                        </td>
                        <td>
                            <span class="xa57-badge@(linea.Activa ? " xa57-badge--active" : " xa57-badge--inactive")">
                                @(linea.Activa ? "Activa" : "Inactiva")
                            </span>
                        </td>
                        <td>
                            <button class="xa57-btn-icon" onclick="editarLinea(@linea.Id)">
                                <i class="material-icons">edit</i>
                            </button>
                            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarLinea(@linea.Id)">
                                <i class="material-icons">delete</i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="lineaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="xa57-modal-content">
            <div class="xa57-modal-header">
                <h5 class="xa57-modal-title">Nueva Línea</h5>
                <button type="button" class="xa57-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="lineaForm">
                <div class="xa57-modal-body">
                    <input type="hidden" id="lineaId" name="Id" />
                    <div class="xa57-form-group">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="lineaNombre" name="Nombre" required />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Nombre del Operador</label>
                        <input type="text" class="form-control" id="lineaNombreOperador" name="NombreOperador" />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Color Primario</label>
                        <input type="color" class="form-control" id="lineaColorPrimario" name="ColorPrimario" style="height:44px;padding:4px;" />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Color Secundario</label>
                        <input type="color" class="form-control" id="lineaColorSecundario" name="ColorSecundario" style="height:44px;padding:4px;" />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Logo URL</label>
                        <input type="text" class="form-control" id="lineaLogoUrl" name="LogoUrl" />
                    </div>
                    <div class="xa57-form-group">
                        <div class="xa57-form-check">
                            <input type="checkbox" class="form-check-input" id="lineaActiva" name="Activa" checked />
                            <label class="form-check-label">Activa</label>
                        </div>
                    </div>
                </div>
                <div class="xa57-modal-footer">
                    <button type="button" class="btn btn-xa57-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-xa57-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.xa57-table-container {
    background: var(--bg-2);
    border: 1px solid var(--bd-1);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ff-b);
    font-size: 0.85rem;
}

.xa57-table thead {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
}

.xa57-table th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--tx-2);
    letter-spacing: 0.02em;
}

.xa57-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--bd-0);
    color: var(--tx-0);
}

.xa57-table tbody tr:last-child td {
    border-bottom: none;
}

.xa57-table tbody tr {
    transition: var(--t);
}

.xa57-table tbody tr:hover {
    background: var(--bg-3);
}

.xa57-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--r-s);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

.xa57-badge--active {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
}

.xa57-badge--inactive {
    background: rgba(107, 114, 128, 0.15);
    color: #9ca3af;
}

.xa57-btn-icon {
    background: var(--bg-3);
    border: 1px solid var(--bd-1);
    color: var(--tx-1);
    border-radius: var(--r-s);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--t);
    margin-right: 4px;
}

.xa57-btn-icon:hover {
    background: var(--bg-4);
    border-color: var(--bd-2);
    color: #fff;
}

.xa57-btn-icon--danger:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #f87171;
}

.xa57-btn-icon .material-icons {
    font-size: 16px;
}

.xa57-modal-content {
    background: var(--bg-2);
    border: 1px solid var(--bd-2);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-modal-header {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.xa57-modal-title {
    font-family: var(--ff-h);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--tx-0);
    margin: 0;
}

.xa57-btn-close {
    background: none;
    border: none;
    color: var(--tx-2);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--t);
}

.xa57-btn-close:hover {
    color: var(--tx-0);
}

.xa57-btn-close::before {
    content: '\e5cd';
    font-family: 'Material Icons';
    font-size: 20px;
}

.xa57-modal-body {
    padding: 20px;
}

.xa57-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--bd-0);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.xa57-form-group {
    margin-bottom: 1rem;
    position: relative;
}

.xa57-form-group .form-control {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    color: var(--tx-0);
    border-radius: var(--r-m);
    padding: 10px 14px;
    font-size: 0.85rem;
    font-family: var(--ff-b);
    outline: none;
    transition: var(--t);
    width: 100%;
}

.xa57-form-group .form-control:focus {
    border-color: var(--bd-3);
    background: var(--bg-4);
    box-shadow: none;
}

.xa57-form-group .form-control::placeholder {
    color: var(--tx-3);
}

.xa57-form-group .form-label {
    font-family: var(--ff-b);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--tx-1);
    margin-bottom: 6px;
    display: block;
}

.xa57-form-check {
    display: flex;
    align-items: center;
    gap: 8px;
}

.xa57-form-check .form-check-input {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    width: 18px;
    height: 18px;
    border-radius: 4px;
    cursor: pointer;
}

.xa57-form-check .form-check-input:checked {
    background: #fff;
    border-color: #fff;
}

.xa57-form-check .form-check-label {
    font-family: var(--ff-b);
    font-size: 0.85rem;
    color: var(--tx-1);
    cursor: pointer;
}
</style>

<script>
function limpiarFormulario() {
    document.getElementById('lineaForm').reset();
    document.getElementById('lineaId').value = '0';
}

async function editarLinea(id) {
    const response = await fetch(`/Admin/LineaDetalle?id=${id}`);
    const linea = await response.json();
    
    document.getElementById('lineaId').value = linea.id;
    document.getElementById('lineaNombre').value = linea.nombre;
    document.getElementById('lineaNombreOperador').value = linea.nombreOperador || '';
    document.getElementById('lineaColorPrimario').value = linea.colorPrimario || '#000000';
    document.getElementById('lineaColorSecundario').value = linea.colorSecundario || '#ffffff';
    document.getElementById('lineaLogoUrl').value = linea.logoUrl || '';
    document.getElementById('lineaActiva').checked = linea.activa;
    
    const modal = new bootstrap.Modal(document.getElementById('lineaModal'));
    modal.show();
}

async function eliminarLinea(id) {
    if (confirm('¿Está seguro de eliminar esta línea?')) {
        await fetch(`/Admin/EliminarLinea?id=${id}`, { method: 'DELETE' });
        location.reload();
    }
}

document.getElementById('lineaForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('lineaId').value;
    const linea = {
        id: parseInt(id) || 0,
        nombre: document.getElementById('lineaNombre').value,
        nombreOperador: document.getElementById('lineaNombreOperador').value,
        colorPrimario: document.getElementById('lineaColorPrimario').value,
        colorSecundario: document.getElementById('lineaColorSecundario').value,
        logoUrl: document.getElementById('lineaLogoUrl').value,
        activa: document.getElementById('lineaActiva').checked
    };
    
    const url = id == '0' ? '/Admin/CrearLinea' : `/Admin/EditarLinea?id=${id}`;
    const method = id == '0' ? 'POST' : 'PUT';
    
    await fetch(url, { method, body: JSON.stringify(linea) });
    location.reload();
});
</script>