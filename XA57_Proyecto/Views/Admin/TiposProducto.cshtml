@model IEnumerable<XA57_Proyecto.Domain.Entities.TipoProducto>
@{
    ViewData["Title"] = "Administrar Tipos de Producto";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="xa57-title">Tipos de Producto</h1>
        <button class="btn btn-xa57-primary" data-bs-toggle="modal" data-bs-target="#tipoModal" onclick="limpiarFormulario()">
            <i class="material-icons">add</i> Nuevo Tipo
        </button>
    </div>
    
    <div class="xa57-table-container">
        <table class="xa57-table" id="tiposTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Máx. Caracteres</th>
                    <th>Permite Nombre</th>
                    <th>Permite # Eco</th>
                    <th>Permite Ruta</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tipo in Model)
                {
                    <tr data-id="@tipo.Id">
                        <td>@tipo.Id</td>
                        <td class="col-nombre">@tipo.Nombre</td>
                        <td class="col-max">@tipo.MaxCaracteres</td>
                        <td class="col-nombre-p">@(tipo.PermiteNombre ? "Sí" : "No")</td>
                        <td class="col-eco-p">@(tipo.PermiteNumeroEconomico ? "Sí" : "No")</td>
                        <td class="col-ruta-p">@(tipo.PermiteRuta ? "Sí" : "No")</td>
                        <td>
                            <button class="xa57-btn-icon" onclick="editarTipo(@tipo.Id)">
                                <i class="material-icons">edit</i>
                            </button>
                            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarTipo(@tipo.Id)">
                                <i class="material-icons">delete</i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="tipoModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="xa57-modal-content">
            <div class="xa57-modal-header">
                <h5 class="xa57-modal-title">Nuevo Tipo de Producto</h5>
                <button type="button" class="xa57-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="tipoForm">
                <div class="xa57-modal-body">
                    <input type="hidden" id="tipoId" name="Id" />
                    <div class="xa57-form-group">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="tipoNombre" name="Nombre" required />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Máximo de Caracteres</label>
                        <input type="number" class="form-control" id="tipoMaxCaracteres" name="MaxCaracteres" value="20" />
                    </div>
                    <div class="xa57-form-group">
                        <div class="xa57-form-check">
                            <input type="checkbox" class="form-check-input" id="tipoPermiteNombre" name="PermiteNombre" checked />
                            <label class="form-check-label">Permite Nombre</label>
                        </div>
                    </div>
                    <div class="xa57-form-group">
                        <div class="xa57-form-check">
                            <input type="checkbox" class="form-check-input" id="tipoPermiteNumeroEconomico" name="PermiteNumeroEconomico" checked />
                            <label class="form-check-label">Permite Número Económico</label>
                        </div>
                    </div>
                    <div class="xa57-form-group">
                        <div class="xa57-form-check">
                            <input type="checkbox" class="form-check-input" id="tipoPermiteRuta" name="PermiteRuta" checked />
                            <label class="form-check-label">Permite Ruta</label>
                        </div>
                    </div>
                </div>
                <div class="xa57-modal-footer">
                    <button type="button" class="btn btn-xa57-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-xa57-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.xa57-table-container {
    background: var(--bg-2);
    border: 1px solid var(--bd-1);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ff-b);
    font-size: 0.85rem;
}

.xa57-table thead {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
}

.xa57-table th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--tx-2);
    letter-spacing: 0.02em;
}

.xa57-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--bd-0);
    color: var(--tx-0);
}

.xa57-table tbody tr:last-child td {
    border-bottom: none;
}

.xa57-table tbody tr {
    transition: var(--t);
}

.xa57-table tbody tr:hover {
    background: var(--bg-3);
}

.xa57-btn-icon {
    background: var(--bg-3);
    border: 1px solid var(--bd-1);
    color: var(--tx-1);
    border-radius: var(--r-s);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--t);
    margin-right: 4px;
}

.xa57-btn-icon:hover {
    background: var(--bg-4);
    border-color: var(--bd-2);
    color: #fff;
}

.xa57-btn-icon--danger:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #f87171;
}

.xa57-btn-icon .material-icons {
    font-size: 16px;
}

.xa57-modal-content {
    background: var(--bg-2);
    border: 1px solid var(--bd-2);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-modal-header {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.xa57-modal-title {
    font-family: var(--ff-h);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--tx-0);
    margin: 0;
}

.xa57-btn-close {
    background: none;
    border: none;
    color: var(--tx-2);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--t);
}

.xa57-btn-close:hover {
    color: var(--tx-0);
}

.xa57-btn-close::before {
    content: '\\e5cd';
    font-family: 'Material Icons';
    font-size: 20px;
}

.xa57-modal-body {
    padding: 20px;
}

.xa57-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--bd-0);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.xa57-form-group {
    margin-bottom: 1rem;
    position: relative;
}

.xa57-form-group .form-control {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    color: var(--tx-0);
    border-radius: var(--r-m);
    padding: 10px 14px;
    font-size: 0.85rem;
    font-family: var(--ff-b);
    outline: none;
    transition: var(--t);
    width: 100%;
}

.xa57-form-group .form-control:focus {
    border-color: var(--bd-3);
    background: var(--bg-4);
    box-shadow: none;
}

.xa57-form-group .form-control::placeholder {
    color: var(--tx-3);
}

.xa57-form-group .form-label {
    font-family: var(--ff-b);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--tx-1);
    margin-bottom: 6px;
    display: block;
}

.xa57-form-check {
    display: flex;
    align-items: center;
    gap: 8px;
}

.xa57-form-check .form-check-input {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    width: 18px;
    height: 18px;
    border-radius: 4px;
    cursor: pointer;
}

.xa57-form-check .form-check-input:checked {
    background: #fff;
    border-color: #fff;
}

.xa57-form-check .form-check-label {
    font-family: var(--ff-b);
    font-size: 0.85rem;
    color: var(--tx-1);
    cursor: pointer;
}
.modal {
    z-index: 1050 !important;
    pointer-events: auto !important;
}

.modal-dialog {
    pointer-events: auto !important;
}

.modal-backdrop {
    z-index: 1040 !important;
}

.modal-show {
    display: block !important;
}
</style>

<script>
function limpiarFormulario() {
    document.getElementById('tipoForm').reset();
    document.getElementById('tipoId').value = '0';
}

async function editarTipo(id) {
    const response = await fetch(`/Admin/ObtenerTipoProducto?id=${id}`);
    if (!response.ok) {
        alert('Error al cargar el tipo');
        return;
    }
    const tipo = await response.json();
    
    document.getElementById('tipoId').value = tipo.id;
    document.getElementById('tipoNombre').value = tipo.nombre;
    document.getElementById('tipoMaxCaracteres').value = tipo.maxCaracteres;
    document.getElementById('tipoPermiteNombre').checked = tipo.permiteNombre;
    document.getElementById('tipoPermiteNumeroEconomico').checked = tipo.permiteNumeroEconomico;
    document.getElementById('tipoPermiteRuta').checked = tipo.permiteRuta;
    
    const modal = new bootstrap.Modal(document.getElementById('tipoModal'));
    modal.show();
}

async function eliminarTipo(id) {
    if (confirm('¿Está seguro de eliminar este tipo?')) {
        const response = await fetch(`/Admin/EliminarTipoProducto?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
            const fila = document.querySelector(`#tiposTable tbody tr[data-id="${id}"]`);
            if (fila) {
                fila.remove(); // En este caso eliminamos la fila ya que no hay soft delete visible aquí
            }
        } else {
            const data = await response.json();
            alert(data.message || 'Error al eliminar el tipo');
        }
    }
}

document.getElementById('tipoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('tipoId').value;
    const tipo = {
        id: parseInt(id) || 0,
        nombre: document.getElementById('tipoNombre').value,
        maxCaracteres: parseInt(document.getElementById('tipoMaxCaracteres').value),
        permiteNombre: document.getElementById('tipoPermiteNombre').checked,
        permiteNumeroEconomico: document.getElementById('tipoPermiteNumeroEconomico').checked,
        permiteRuta: document.getElementById('tipoPermiteRuta').checked
    };
    
    const url = id == '0' ? '/Admin/CrearTipoProducto' : `/Admin/EditarTipoProducto?id=${id}`;
    const method = id == '0' ? 'POST' : 'PUT';
    
    const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(tipo)
    });
    
    if (response.ok) {
        const modalElement = document.getElementById('tipoModal');
        const modal = bootstrap.Modal.getInstance(modalElement);
        modal.hide();
        
        if (id == '0') {
            const nuevoTipo = await response.json();
            agregarFilaTabla(nuevoTipo);
        } else {
            actualizarFilaTabla(tipo);
        }
    } else {
        const data = await response.json();
        alert(data.message || 'Error al guardar el tipo');
    }
});

function agregarFilaTabla(t) {
    const tbody = document.querySelector('#tiposTable tbody');
    const tr = document.createElement('tr');
    tr.setAttribute('data-id', t.id);
    
    tr.innerHTML = `
        <td>${t.id}</td>
        <td class="col-nombre">${t.nombre}</td>
        <td class="col-max">${t.maxCaracteres}</td>
        <td class="col-nombre-p">${t.permiteNombre ? "Sí" : "No"}</td>
        <td class="col-eco-p">${t.permiteNumeroEconomico ? "Sí" : "No"}</td>
        <td class="col-ruta-p">${t.permiteRuta ? "Sí" : "No"}</td>
        <td>
            <button class="xa57-btn-icon" onclick="editarTipo(${t.id})">
                <i class="material-icons">edit</i>
            </button>
            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarTipo(${t.id})">
                <i class="material-icons">delete</i>
            </button>
        </td>
    `;
    tbody.appendChild(tr);
}

function actualizarFilaTabla(t) {
    const fila = document.querySelector(`#tiposTable tbody tr[data-id="${t.id}"]`);
    if (!fila) return;
    
    fila.querySelector('.col-nombre').textContent = t.nombre;
    fila.querySelector('.col-max').textContent = t.maxCaracteres;
    fila.querySelector('.col-nombre-p').textContent = t.permiteNombre ? "Sí" : "No";
    fila.querySelector('.col-eco-p').textContent = t.permiteNumeroEconomico ? "Sí" : "No";
    fila.querySelector('.col-ruta-p').textContent = t.permiteRuta ? "Sí" : "No";
}
</script>