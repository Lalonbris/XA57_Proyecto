@model IEnumerable<XA57_Proyecto.Domain.Entities.Producto>
@{
    ViewData["Title"] = "Administrar Productos";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="xa57-title">Productos</h1>
        <button class="btn btn-xa57-primary" data-bs-toggle="modal" data-bs-target="#productoModal" onclick="limpiarFormulario()">
            <i class="material-icons">add</i> Nuevo Producto
        </button>
    </div>
    
    <div class="xa57-table-container">
        <table class="xa57-table" id="productosTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Tamaño</th>
                    <th>Línea</th>
                    <th>Precio</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr data-id="@producto.Id">
                        <td>@producto.Id</td>
                        <td class="col-nombre">@producto.Nombre</td>
                        <td class="col-tamano">@producto.Tamano</td>
                        <td class="col-linea">@producto.Linea?.Nombre</td>
                        <td class="col-precio">$@producto.Precio.ToString("N2")</td>
                        <td class="col-tipo">@producto.TipoProducto?.Nombre</td>
                        <td class="col-estado">@(producto.Activo ? "Activo" : "Inactivo")</td>
                        <td>
                            <button class="xa57-btn-icon" onclick="editarProducto(@producto.Id)">
                                <i class="material-icons">edit</i>
                            </button>
                            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarProducto(@producto.Id)">
                                <i class="material-icons">delete</i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="productoModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="xa57-modal-content">
            <div class="xa57-modal-header">
                <h5 class="xa57-modal-title">Nuevo Producto</h5>
                <button type="button" class="xa57-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="productoForm">
                <div class="xa57-modal-body">
                    <input type="hidden" id="productoId" name="Id" />
                    <div class="xa57-form-group">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="productoNombre" name="Nombre" required />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="productoDescripcion" name="Descripcion"></textarea>
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Precio</label>
                        <input type="number" class="form-control" id="productoPrecio" name="Precio" step="0.01" required />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Imagen URL</label>
                        <input type="text" class="form-control" id="productoImagenUrl" name="ImagenUrl" />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Tamaño</label>
                        <input type="text" class="form-control" id="productoTamano" name="Tamano" placeholder="Ej: Grande, XL, 20cm" />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Tipo de Producto</label>
                        <select class="form-select" id="productoTipoProductoId" name="TipoProductoId">
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Línea</label>
                        <select class="form-select" id="productoLineaId" name="LineaId">
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>
                    <div class="xa57-form-group">
                        <div class="xa57-form-check">
                            <input type="checkbox" class="form-check-input" id="productoActivo" name="Activo" checked />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
                <div class="xa57-modal-footer">
                    <button type="button" class="btn btn-xa57-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-xa57-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.modal {
    z-index: 1050 !important;
    pointer-events: auto !important;
}

.modal-dialog {
    pointer-events: auto !important;
}

.modal-backdrop {
    z-index: 1040 !important;
}

.modal-show {
    display: block !important;
}

.xa57-table-container {
    background: var(--bg-2);
    border: 1px solid var(--bd-1);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ff-b);
    font-size: 0.85rem;
}

.xa57-table thead {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
}

.xa57-table th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--tx-2);
    letter-spacing: 0.02em;
}

.xa57-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--bd-0);
    color: var(--tx-0);
}

.xa57-table tbody tr:last-child td {
    border-bottom: none;
}

.xa57-table tbody tr {
    transition: var(--t);
}

.xa57-table tbody tr:hover {
    background: var(--bg-3);
}

.xa57-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--r-s);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

.xa57-badge--active {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
}

.xa57-badge--inactive {
    background: rgba(107, 114, 128, 0.15);
    color: #9ca3af;
}

.xa57-btn-icon {
    background: var(--bg-3);
    border: 1px solid var(--bd-1);
    color: var(--tx-1);
    border-radius: var(--r-s);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--t);
    margin-right: 4px;
}

.xa57-btn-icon:hover {
    background: var(--bg-4);
    border-color: var(--bd-2);
    color: #fff;
}

.xa57-btn-icon--danger:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #f87171;
}

.xa57-btn-icon .material-icons {
    font-size: 16px;
}

.xa57-modal-content {
    background: var(--bg-2);
    border: 1px solid var(--bd-2);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-modal-header {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.xa57-modal-title {
    font-family: var(--ff-h);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--tx-0);
    margin: 0;
}

.xa57-btn-close {
    background: none;
    border: none;
    color: var(--tx-2);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--t);
}

.xa57-btn-close:hover {
    color: var(--tx-0);
}

.xa57-btn-close::before {
    content: '\\e5cd';
    font-family: 'Material Icons';
    font-size: 20px;
}

.xa57-modal-body {
    padding: 20px;
}

.xa57-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--bd-0);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.xa57-form-group {
    margin-bottom: 1rem;
    position: relative;
}

.xa57-form-group .form-control,
.xa57-form-group .form-select {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    color: var(--tx-0);
    border-radius: var(--r-m);
    padding: 10px 14px;
    font-size: 0.85rem;
    font-family: var(--ff-b);
    outline: none;
    transition: var(--t);
    width: 100%;
}

.xa57-form-group .form-control:focus,
.xa57-form-group .form-select:focus {
    border-color: var(--bd-3);
    background: var(--bg-4);
    box-shadow: none;
}

.xa57-form-group .form-control::placeholder {
    color: var(--tx-3);
}

.xa57-form-group .form-label {
    font-family: var(--ff-b);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--tx-1);
    margin-bottom: 6px;
    display: block;
}

.xa57-form-check {
    display: flex;
    align-items: center;
    gap: 8px;
}

.xa57-form-check .form-check-input {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    width: 18px;
    height: 18px;
    border-radius: 4px;
    cursor: pointer;
}

.xa57-form-check .form-check-input:checked {
    background: #fff;
    border-color: #fff;
}

.xa57-form-check .form-check-label {
    font-family: var(--ff-b);
    font-size: 0.85rem;
    color: var(--tx-1);
    cursor: pointer;
}
</style>

<script>
async function cargarTiposProducto() {
    const response = await fetch('/Admin/ObtenerTiposProducto');
    const tipos = await response.json();
    const select = document.getElementById('productoTipoProductoId');
    select.innerHTML = '<option value="">Seleccionar...</option>';
    tipos.forEach(tipo => {
        const option = document.createElement('option');
        option.value = tipo.id;
        option.textContent = tipo.nombre;
        select.appendChild(option);
    });
}

async function cargarLineas() {
    const response = await fetch('/Admin/ObtenerLineas');
    const lineas = await response.json();
    const select = document.getElementById('productoLineaId');
    select.innerHTML = '<option value="">Seleccionar...</option>';
    lineas.forEach(linea => {
        const option = document.createElement('option');
        option.value = linea.id;
        option.textContent = linea.nombre;
        select.appendChild(option);
    });
}

cargarTiposProducto();
cargarLineas();

function limpiarFormulario() {
    document.getElementById('productoForm').reset();
    document.getElementById('productoId').value = '0';
    document.getElementById('productoLineaId').value = '';
    document.getElementById('productoTipoProductoId').value = '';
}

async function editarProducto(id) {
    const response = await fetch(`/Admin/ObtenerProducto?id=${id}`);
    if (!response.ok) {
        alert('Error al cargar el producto');
        return;
    }
    const producto = await response.json();
    
    document.getElementById('productoId').value = producto.id;
    document.getElementById('productoNombre').value = producto.nombre;
    document.getElementById('productoDescripcion').value = producto.descripcion || '';
    document.getElementById('productoPrecio').value = producto.precio;
    document.getElementById('productoImagenUrl').value = producto.imagenUrl || '';
    document.getElementById('productoTamano').value = producto.tamano || '';
    document.getElementById('productoActivo').checked = producto.activo;
    
    document.getElementById('productoTipoProductoId').value = producto.tipoProductoId || '';
    document.getElementById('productoLineaId').value = producto.lineaId || '';
    
    const modal = new bootstrap.Modal(document.getElementById('productoModal'));
    modal.show();
}

async function eliminarProducto(id) {
    if (confirm('¿Está seguro de eliminar este producto?')) {
        const response = await fetch(`/Admin/EliminarProducto?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
            // Actualizar la fila en la tabla para mostrar que está inactivo
            const fila = document.querySelector(`#productosTable tbody tr[data-id="${id}"]`);
            if (fila) {
                fila.remove();
            }
        } else {
            const data = await response.json();
            alert(data.message || 'Error al eliminar el producto');
        }
    }
}

document.getElementById('productoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('productoId').value;
    const producto = {
        id: parseInt(id) || 0,
        nombre: document.getElementById('productoNombre').value,
        descripcion: document.getElementById('productoDescripcion').value,
        precio: parseFloat(document.getElementById('productoPrecio').value),
        imagenUrl: document.getElementById('productoImagenUrl').value,
        tamano: document.getElementById('productoTamano').value,
        tipoProductoId: parseInt(document.getElementById('productoTipoProductoId').value) || null,
        lineaId: parseInt(document.getElementById('productoLineaId').value) || null,
        activo: document.getElementById('productoActivo').checked
    };
    
    const url = id == '0' ? '/Admin/CrearProducto' : `/Admin/EditarProducto?id=${id}`;
    const method = id == '0' ? 'POST' : 'PUT';
    
    const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(producto)
    });
    
    if (response.ok) {
        const modalElement = document.getElementById('productoModal');
        const modal = bootstrap.Modal.getInstance(modalElement);
        modal.hide();
        
        if (id == '0') {
            const nuevoProducto = await response.json();
            agregarFilaTabla(nuevoProducto);
        } else {
            actualizarFilaTabla(producto);
        }
    } else {
        const data = await response.json();
        let errorMsg = 'Error al guardar el producto';
        if (data.message) errorMsg = data.message;
        else if (data.errors) errorMsg = Object.values(data.errors).flat().join('\n');
        
        alert(errorMsg);
    }
});

function agregarFilaTabla(p) {
    const tbody = document.querySelector('#productosTable tbody');
    const tr = document.createElement('tr');
    tr.setAttribute('data-id', p.id);
    
    const tipoNombre = document.querySelector(`#productoTipoProductoId option[value="${p.tipoProductoId}"]`)?.textContent || '';
    const lineaNombre = document.querySelector(`#productoLineaId option[value="${p.lineaId}"]`)?.textContent || '';
    
    tr.innerHTML = `
        <td>${p.id}</td>
        <td class="col-nombre">${p.nombre}</td>
        <td class="col-tamano">${p.tamano || ''}</td>
        <td class="col-linea">${lineaNombre}</td>
        <td class="col-precio">$${p.precio.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
        <td class="col-tipo">${tipoNombre}</td>
        <td class="col-estado">
            <span class="xa57-badge${p.activo ? " xa57-badge--active" : " xa57-badge--inactive"}">
                ${p.activo ? "Activo" : "Inactivo"}
            </span>
        </td>
        <td>
            <button class="xa57-btn-icon" onclick="editarProducto(${p.id})">
                <i class="material-icons">edit</i>
            </button>
            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarProducto(${p.id})">
                <i class="material-icons">delete</i>
            </button>
        </td>
    `;
    tbody.appendChild(tr);
}

function actualizarFilaTabla(p) {
    const fila = document.querySelector(`#productosTable tbody tr[data-id="${p.id}"]`);
    if (!fila) return;
    
    const tipoNombre = document.querySelector(`#productoTipoProductoId option[value="${p.tipoProductoId}"]`)?.textContent || '';
    const lineaNombre = document.querySelector(`#productoLineaId option[value="${p.lineaId}"]`)?.textContent || '';
    
    fila.querySelector('.col-nombre').textContent = p.nombre;
    fila.querySelector('.col-tamano').textContent = p.tamano || '';
    fila.querySelector('.col-linea').textContent = lineaNombre;
    fila.querySelector('.col-precio').textContent = `$${p.precio.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    fila.querySelector('.col-tipo').textContent = tipoNombre;
    
    const badge = fila.querySelector('.xa57-badge');
    badge.className = `xa57-badge${p.activo ? " xa57-badge--active" : " xa57-badge--inactive"}`;
    badge.textContent = p.activo ? "Activo" : "Inactivo";
}
</script>