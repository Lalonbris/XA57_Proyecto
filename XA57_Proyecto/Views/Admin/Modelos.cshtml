@model IEnumerable<XA57_Proyecto.Domain.Entities.ModeloAutobus>
@{
    ViewData["Title"] = "Administrar Modelos de Autobús";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="xa57-title">Modelos de Autobús</h1>
        <button class="btn btn-xa57-primary" data-bs-toggle="modal" data-bs-target="#modeloModal" onclick="limpiarFormulario()">
            <i class="material-icons">add</i> Nuevo Modelo
        </button>
    </div>
    
    <div class="xa57-table-container">
        <table class="xa57-table" id="modelosTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Fabricante</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var modelo in Model)
                {
                    <tr data-id="@modelo.Id">
                        <td>@modelo.Id</td>
                        <td class="col-nombre">@modelo.Nombre</td>
                        <td class="col-fabricante">@modelo.Fabricante</td>
                        <td class="col-estado">@(modelo.Activo ? "Activo" : "Inactivo")</td>
                        <td>
                            <button class="xa57-btn-icon" onclick="editarModelo(@modelo.Id)">
                                <i class="material-icons">edit</i>
                            </button>
                            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarModelo(@modelo.Id)">
                                <i class="material-icons">delete</i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modeloModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="xa57-modal-content">
            <div class="xa57-modal-header">
                <h5 class="xa57-modal-title">Nuevo Modelo</h5>
                <button type="button" class="xa57-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="modeloForm">
                <div class="xa57-modal-body">
                    <input type="hidden" id="modeloId" name="Id" />
                    <div class="xa57-form-group">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="modeloNombre" name="Nombre" required />
                    </div>
                    <div class="xa57-form-group">
                        <label class="form-label">Fabricante</label>
                        <input type="text" class="form-control" id="modeloFabricante" name="Fabricante" required />
                    </div>
                    <div class="xa57-form-group">
                        <div class="xa57-form-check">
                            <input type="checkbox" class="form-check-input" id="modeloActivo" name="Activo" checked />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
                <div class="xa57-modal-footer">
                    <button type="button" class="btn btn-xa57-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-xa57-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
/* Estilos consistentes con Productos y Lineas */
.xa57-table-container {
    background: var(--bg-2);
    border: 1px solid var(--bd-1);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ff-b);
    font-size: 0.85rem;
}

.xa57-table thead {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
}

.xa57-table th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--tx-2);
    letter-spacing: 0.02em;
}

.xa57-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--bd-0);
    color: var(--tx-0);
}

.xa57-table tbody tr:last-child td {
    border-bottom: none;
}

.xa57-table tbody tr {
    transition: var(--t);
}

.xa57-table tbody tr:hover {
    background: var(--bg-3);
}

.xa57-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--r-s);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

.xa57-badge--active {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
}

.xa57-badge--inactive {
    background: rgba(107, 114, 128, 0.15);
    color: #9ca3af;
}

.xa57-btn-icon {
    background: var(--bg-3);
    border: 1px solid var(--bd-1);
    color: var(--tx-1);
    border-radius: var(--r-s);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--t);
    margin-right: 4px;
}

.xa57-btn-icon:hover {
    background: var(--bg-4);
    border-color: var(--bd-2);
    color: #fff;
}

.xa57-btn-icon--danger:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #f87171;
}

.xa57-btn-icon .material-icons {
    font-size: 16px;
}

.xa57-modal-content {
    background: var(--bg-2);
    border: 1px solid var(--bd-2);
    border-radius: var(--r-xl);
    overflow: hidden;
}

.xa57-modal-header {
    background: var(--bg-3);
    border-bottom: 1px solid var(--bd-1);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.xa57-modal-title {
    font-family: var(--ff-h);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--tx-0);
    margin: 0;
}

.xa57-btn-close {
    background: none;
    border: none;
    color: var(--tx-2);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--t);
}

.xa57-btn-close:hover {
    color: var(--tx-0);
}

.xa57-btn-close::before {
    content: '\\e5cd';
    font-family: 'Material Icons';
    font-size: 20px;
}

.xa57-modal-body {
    padding: 20px;
}

.xa57-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid var(--bd-0);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.xa57-form-group {
    margin-bottom: 1rem;
    position: relative;
}

.xa57-form-group .form-control {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    color: var(--tx-0);
    border-radius: var(--r-m);
    padding: 10px 14px;
    font-size: 0.85rem;
    font-family: var(--ff-b);
    outline: none;
    transition: var(--t);
    width: 100%;
}

.xa57-form-group .form-control:focus {
    border-color: var(--bd-3);
    background: var(--bg-4);
    box-shadow: none;
}

.xa57-form-group .form-label {
    font-family: var(--ff-b);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--tx-1);
    margin-bottom: 6px;
    display: block;
}

.xa57-form-check {
    display: flex;
    align-items: center;
    gap: 8px;
}

.xa57-form-check .form-check-input {
    background: var(--bg-3);
    border: 1px solid var(--bd-2);
    width: 18px;
    height: 18px;
    border-radius: 4px;
    cursor: pointer;
}

.xa57-form-check .form-check-input:checked {
    background: #fff;
    border-color: #fff;
}

.xa57-form-check .form-check-label {
    font-family: var(--ff-b);
    font-size: 0.85rem;
    color: var(--tx-1);
    cursor: pointer;
}
.modal {
    z-index: 1050 !important;
    pointer-events: auto !important;
}

.modal-dialog {
    pointer-events: auto !important;
}

.modal-backdrop {
    z-index: 1040 !important;
}

.modal-show {
    display: block !important;
}
</style>

<script>
function limpiarFormulario() {
    document.getElementById('modeloForm').reset();
    document.getElementById('modeloId').value = '0';
}

async function editarModelo(id) {
    const response = await fetch(`/Admin/ObtenerModelo?id=${id}`);
    if (!response.ok) {
        alert('Error al cargar el modelo');
        return;
    }
    const modelo = await response.json();
    
    document.getElementById('modeloId').value = modelo.id;
    document.getElementById('modeloNombre').value = modelo.nombre;
    document.getElementById('modeloFabricante').value = modelo.fabricante;
    document.getElementById('modeloActivo').checked = modelo.activo;
    
    const modal = new bootstrap.Modal(document.getElementById('modeloModal'));
    modal.show();
}

async function eliminarModelo(id) {
    if (confirm('¿Está seguro de eliminar este modelo?')) {
        const response = await fetch(`/Admin/EliminarModelo?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
            const fila = document.querySelector(`#modelosTable tbody tr[data-id="${id}"]`);
            if (fila) {
                fila.remove();
            }
        } else {
            const data = await response.json();
            alert(data.message || 'Error al eliminar el modelo');
        }
    }
}

document.getElementById('modeloForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('modeloId').value;
    const modelo = {
        id: parseInt(id) || 0,
        nombre: document.getElementById('modeloNombre').value,
        fabricante: document.getElementById('modeloFabricante').value,
        activo: document.getElementById('modeloActivo').checked
    };
    
    const url = id == '0' ? '/Admin/CrearModelo' : `/Admin/EditarModelo?id=${id}`;
    const method = id == '0' ? 'POST' : 'PUT';
    
    const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(modelo)
    });
    
    if (response.ok) {
        const modalElement = document.getElementById('modeloModal');
        const modal = bootstrap.Modal.getInstance(modalElement);
        modal.hide();
        
        if (id == '0') {
            const nuevoModelo = await response.json();
            agregarFilaTabla(nuevoModelo);
        } else {
            actualizarFilaTabla(modelo);
        }
    } else {
        const data = await response.json();
        alert(data.message || 'Error al guardar el modelo');
    }
});

function agregarFilaTabla(m) {
    const tbody = document.querySelector('#modelosTable tbody');
    const tr = document.createElement('tr');
    tr.setAttribute('data-id', m.id);
    
    tr.innerHTML = `
        <td>${m.id}</td>
        <td class="col-nombre">${m.nombre}</td>
        <td class="col-fabricante">${m.fabricante}</td>
        <td class="col-estado">
            <span class="xa57-badge${m.activo ? " xa57-badge--active" : " xa57-badge--inactive"}">
                ${m.activo ? "Activo" : "Inactivo"}
            </span>
        </td>
        <td>
            <button class="xa57-btn-icon" onclick="editarModelo(${m.id})">
                <i class="material-icons">edit</i>
            </button>
            <button class="xa57-btn-icon xa57-btn-icon--danger" onclick="eliminarModelo(${m.id})">
                <i class="material-icons">delete</i>
            </button>
        </td>
    `;
    tbody.appendChild(tr);
}

function actualizarFilaTabla(m) {
    const fila = document.querySelector(`#modelosTable tbody tr[data-id="${m.id}"]`);
    if (!fila) return;
    
    fila.querySelector('.col-nombre').textContent = m.nombre;
    fila.querySelector('.col-fabricante').textContent = m.fabricante;
    
    const badge = fila.querySelector('.xa57-badge');
    badge.className = `xa57-badge${m.activo ? " xa57-badge--active" : " xa57-badge--inactive"}`;
    badge.textContent = m.activo ? "Activo" : "Inactivo";
}
</script>